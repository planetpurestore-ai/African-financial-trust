# Core
NODE_ENV=production
PORT=3000
PUBLIC_ORIGIN=https://your-public-origin.example
DATABASE_URL=mysql://user:password@host:3306/aft
AUTO_MIGRATE=true

# Security (generate with: openssl rand -base64 32)
APP_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=aft_session
SESSION_HOURS=12
COOKIE_SECURE=true

# Storage and limits
STORAGE_DIR=/data
MAX_UPLOAD_MB=25
DATA_RETENTION_DAYS=2555

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=12

# Background jobs
JOB_WORKER_ENABLED=true
JOB_CONCURRENCY=2

# Optional AI extraction (never used for verification decisions)
AI_EXTRACTION_ENABLED=false
OPENAI_API_BASE=
OPENAI_API_KEY=
AI_EXTRACTION_MODEL=
